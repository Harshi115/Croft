{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": { "singularName": "project", "pluralName": "projects", "displayName": "Project" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "summary": { "type": "text", "maxLength": 255, "required": true },
    "body": { "type": "blocks" },
    "heroImage": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["images"] },
    "gallery": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "client": { "type": "string" },
    "location": { "type": "string" },
    "sector": { "type": "relation", "relation": "manyToOne", "target": "api::sector.sector", "inversedBy": "projects" },
    "serviceType": { "type": "relation", "relation": "manyToMany", "target": "api::service.service" },
    "projectStatus": { "type": "enumeration", "enum": ["planning", "in-progress", "completed"], "default": "completed" },
    "completionDate": { "type": "date" },
    "value": { "type": "string" },
    "featured": { "type": "boolean", "default": false },
    "testimonialQuote": { "type": "text" },
    "testimonialAuthor": { "type": "string" },
    "confidential": { "type": "boolean", "default": false, "description": "If true, client/value fields are hidden from public output" },
    "metaTitle": { "type": "string" },
    "metaDescription": { "type": "text", "maxLength": 160 },
    "ogImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "legacySlug": { "type": "string", "description": "Original WordPress slug for redirect mapping" }
  }
}
